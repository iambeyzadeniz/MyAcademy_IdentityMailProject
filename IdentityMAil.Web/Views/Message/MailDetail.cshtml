@model UserMessage

@{
    ViewData["Title"] = "MailDetail";
}

<h1>Mail Detayı</h1>

<table class="table table-bordered">
    <tr>
        <th>Gönderen</th>
        <td>@Model.Sender.FirstName @Model.Sender.LastName</td>
    </tr>
    <tr>
        <th>Gönderen Email</th>
        <td>@Model.Sender.Email</td>
    </tr>
    <tr>
        <th>Konu</th>
        <td>@Model.Subject</td>
    </tr>
    <tr>
        <th>Tarih</th>
        <td>@Model.SendDate</td>
    </tr>
    <tr>
        <th>İçerik</th>
        <td>@Model.Body</td>
    </tr>
</table>

<a href="/Message/Index" class="btn btn-outline-dark"> Mesajlara Geri Dön</a>
